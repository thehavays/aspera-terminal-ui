# ==============================================================================
# Aspera Terminal UI - Environment & Configuration Template
# Copy this file to .env if using environment overrides.
# In normal usage, credentials and endpoints are configured interactively via:
#   aspera-terminal-ui login
# and stored securely in the system keyring.
# NEVER COMMIT REAL CREDENTIALS OR TOKENS TO VERSION CONTROL!
# ==============================================================================

# Optional Aspera Endpoint URL
ASPERA_ENDPOINT=https://aspera.example.com/

# Optional Client / User Configuration
ASPERA_USERNAME=your_username
ASPERA_CLIENT_ID=your_client_id
# ASPERA_CLIENT_SECRET=your_client_secret
